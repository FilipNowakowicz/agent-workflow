# Runtime telemetry / operator-local state — not repo policy.
# Mirrors the nixos-config repo's ignore of .agents/state/*.
/state/outcomes/*
!/state/outcomes/.gitkeep
/state/sessions/*
!/state/sessions/.gitkeep
/state/review/*
!/state/review/.gitkeep
/state/freezes/*
!/state/freezes/.gitkeep

# Machine-local, never published: live skill sync output and private audits.
/personal-skills/synced/
/audits/

# Nix
/result
/result-*
.direnv/
