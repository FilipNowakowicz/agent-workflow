#!/usr/bin/env bash
# Validate local reviewer-evidence JSON for the agent issue-to-PR loop.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: agent-review-evidence-check <evidence.json>
       agent-review-evidence-check --self-test

Validate a local reviewer-evidence JSON file. The check is intentionally
offline: it verifies structure and required evidence fields (including the
40-hex head_sha of the PR commit that was reviewed, and no fields outside
schemas/reviewer-evidence.schema.json), but does not call GitHub or decide
merge authority. agent-merge-gate compares head_sha with the PR's current head.
EOF
}

die() {
  printf 'agent-review-evidence-check: %s\n' "$*" >&2
  exit 2
}

validate_file() {
  local file="$1"
  [[ -f $file ]] || die "evidence file not found: $file"
  command -v jq >/dev/null 2>&1 || die "jq not found"

  jq -e '
    def nonempty_string: type == "string" and length > 0;
    def only_keys($allowed): (keys - $allowed) == [];
    (.schema == "agent-reviewer-evidence/v1")
    and only_keys(["schema", "issue", "pr", "head_sha", "result", "acceptance_criteria", "validation_commands", "residual_risk"])
    and (.head_sha | type == "string" and test("^[0-9a-f]{40}$"))
    and (.issue | type == "number" and . >= 1 and floor == .)
    and (.pr | type == "number" and . >= 1 and floor == .)
    and (.result | IN("approved", "changes_requested", "blocked"))
    and (.residual_risk | nonempty_string)
    and (.acceptance_criteria | type == "array" and length > 0)
    and (
      .acceptance_criteria
      | all(
          type == "object"
          and only_keys(["criterion", "evidence"])
          and (.criterion | nonempty_string)
          and (.evidence | nonempty_string)
        )
    )
    and (.validation_commands | type == "array" and length > 0)
    and (
      .validation_commands
      | all(
          type == "object"
          and only_keys(["command", "result", "notes"])
          and (.command | nonempty_string)
          and (.result | IN("passed", "failed", "skipped"))
          and ((has("notes") | not) or (.notes | type == "string"))
        )
    )
  ' "$file" >/dev/null ||
    die "$file: invalid reviewer evidence"
}

self_test() {
  local tmp good missing_acceptance missing_validation_result script_path
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  good="$tmp/good.json"
  missing_acceptance="$tmp/missing-acceptance.json"
  missing_validation_result="$tmp/missing-validation-result.json"
  script_path="${BASH_SOURCE[0]}"

  cat >"$good" <<'EOF'
{
  "schema": "agent-reviewer-evidence/v1",
  "issue": 227,
  "pr": 999,
  "head_sha": "0123456789abcdef0123456789abcdef01234567",
  "result": "approved",
  "acceptance_criteria": [
    {
      "criterion": "validator accepts passing reviewer evidence",
      "evidence": "agent-review-evidence-check good.json exited 0"
    }
  ],
  "validation_commands": [
    {
      "command": "bash .agents/scripts/agent-review-evidence-check --self-test",
      "result": "passed"
    }
  ],
  "residual_risk": "Schema is advisory until later automation consumes it."
}
EOF

  cat >"$missing_acceptance" <<'EOF'
{
  "schema": "agent-reviewer-evidence/v1",
  "issue": 227,
  "pr": 999,
  "head_sha": "0123456789abcdef0123456789abcdef01234567",
  "result": "approved",
  "acceptance_criteria": [],
  "validation_commands": [
    {
      "command": "bash .agents/scripts/agent-review-evidence-check --self-test",
      "result": "passed"
    }
  ],
  "residual_risk": "None."
}
EOF

  cat >"$missing_validation_result" <<'EOF'
{
  "schema": "agent-reviewer-evidence/v1",
  "issue": 227,
  "pr": 999,
  "head_sha": "0123456789abcdef0123456789abcdef01234567",
  "result": "approved",
  "acceptance_criteria": [
    {
      "criterion": "validator rejects missing validation result",
      "evidence": "fixture intentionally omits validation_commands[0].result"
    }
  ],
  "validation_commands": [
    {
      "command": "bash .agents/scripts/agent-review-evidence-check --self-test"
    }
  ],
  "residual_risk": "None."
}
EOF

  "$script_path" "$good"

  if "$script_path" "$missing_acceptance" 2>/dev/null; then
    die "self-test: expected missing acceptance criteria fixture to fail"
  fi

  if "$script_path" "$missing_validation_result" 2>/dev/null; then
    die "self-test: expected missing validation result fixture to fail"
  fi

  # Evidence must name the PR head commit it reviewed.
  jq 'del(.head_sha)' "$good" >"$tmp/no-sha.json"
  if "$script_path" "$tmp/no-sha.json" 2>/dev/null; then
    die "self-test: expected evidence without head_sha to fail"
  fi
  jq '.head_sha = "abc123"' "$good" >"$tmp/short-sha.json"
  if "$script_path" "$tmp/short-sha.json" 2>/dev/null; then
    die "self-test: expected a non-40-hex head_sha to fail"
  fi

  # Unknown fields are rejected, matching additionalProperties: false in
  # schemas/reviewer-evidence.schema.json.
  jq '.extra_field_not_in_schema = "z"' "$good" >"$tmp/extra.json"
  if "$script_path" "$tmp/extra.json" 2>/dev/null; then
    die "self-test: expected an unknown top-level field to fail"
  fi
  jq '.validation_commands[0].exit_code = 0' "$good" >"$tmp/extra-nested.json"
  if "$script_path" "$tmp/extra-nested.json" 2>/dev/null; then
    die "self-test: expected an unknown validation_commands field to fail"
  fi

  printf 'agent-review-evidence-check self-test passed\n'
}

case "${1:-}" in
--self-test)
  self_test
  ;;
-h | --help)
  usage
  ;;
"")
  usage >&2
  exit 2
  ;;
*)
  [[ $# -eq 1 ]] || die "expected exactly one evidence JSON file"
  validate_file "$1"
  ;;
esac
